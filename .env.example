# Supabase project (server-only — never exposed to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The PIN that unlocks the app, and the secret used to sign the session
# cookie once you've entered it. Pick a long random string for the secret —
# e.g. `openssl rand -hex 32`.
APP_PIN=your-pin
SESSION_SECRET=a-long-random-string

# Authorizes the daily Vercel Cron job (see vercel.json) that posts due
# subscription payments. Vercel automatically sends this as a Bearer token
# to cron routes when the env var is set — e.g. `openssl rand -hex 32`.
CRON_SECRET=a-long-random-string
